PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/archivos
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES=8h

# Carpeta raíz donde viven "archivos/<categoria>/" y la carpeta temporal de subida
STORAGE_ROOT=./storage
MAX_FILE_MB=20

# Origen del frontend React (soporte para 5173, 5174 y red local)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174

# Correo para notificaciones (opcional; si SMTP_HOST está vacío solo se escribe en consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=archivo@tuinstitucion.com
NOTIFY_TO=secretaria@tuinstitucion.com
